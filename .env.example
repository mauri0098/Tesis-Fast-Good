# Copiá este archivo como .env y completá los valores reales.
# El .env NUNCA se sube al repositorio.

# Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=

# Envío de mails (recuperar contraseña) — App Password de Gmail, no la contraseña de la cuenta
MAIL_USER=
MAIL_PASS=

# Firma de los tokens de sesión (usar un valor largo y aleatorio)
JWT_SECRET=

# PIN para anular pedidos
ADMIN_PIN=

# Usuario administrador que usa tests/test_e2e.js
TEST_ADMIN_USER=
TEST_ADMIN_PASS=
