# Copiá este archivo como .env y completá los valores reales.
# El .env NUNCA se sube al repositorio (está en .gitignore).

# ── Supabase ──────────────────────────────────────────────
# URL del proyecto (Supabase → Project Settings → API → Project URL)
SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave service_role (Supabase → Project Settings → API). Es SECRETA: saltea RLS y
# solo la usa el servidor. Nunca en el frontend ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role

# ── Sesión ────────────────────────────────────────────────
# Firma de los tokens de sesión (JWT). Un valor largo y aleatorio, por ejemplo
# el resultado de: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambiar-por-un-valor-largo-y-aleatorio

# ── Pedidos ───────────────────────────────────────────────
# PIN que se pide para anular un pedido (de 4 a 8 dígitos)
ADMIN_PIN=000000

# ── Envío de mails (recuperar contraseña) ─────────────────
# Cuenta de Gmail que envía los mails
MAIL_USER=tu-cuenta@gmail.com
# App Password de Gmail (Cuenta de Google → Seguridad → Contraseñas de aplicaciones), no la contraseña de la cuenta
MAIL_PASS=tu-app-password

# ── Servidor ──────────────────────────────────────────────
# Puerto en el que escucha el servidor (el hosting suele definirlo solo; si no, 3000)
PORT=3000
# "production" en el servidor publicado (activa trust proxy); "development" en tu máquina
NODE_ENV=development
# Dominio(s) desde donde se usa la app publicada, con https:// y sin barra final; varios separados por coma.
# localhost ya está permitido para desarrollo. Ej: https://fastgood.com.ar,https://www.fastgood.com.ar
CORS_ORIGIN=https://tu-dominio.com

# ── Solo para pruebas (tests/test_e2e.js) ─────────────────
# Usuario administrador con el que el test inicia sesión. No hace falta en el servidor publicado.
TEST_ADMIN_USER=
TEST_ADMIN_PASS=
